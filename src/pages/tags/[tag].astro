---
import BlogCard from "@/components/BlogCard.astro";
import config from "@/config/config.json";
import BlogBase from "@/layouts/BlogBase.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize } from "@/lib/utils/textConverter";
import BlogPageHeader from "@/partials/BlogPageHeader.astro";

export async function getStaticPaths() {
  const tags = await getTaxonomy(config.settings.blog_folder, "tags");

  return tags.map((tag) => {
    return {
      params: { tag },
    };
  });
}

const { tag } = Astro.params;
const posts = await getSinglePage(config.settings.blog_folder);
const filterByTags = taxonomyFilter(posts, "tags", tag!);
---

<BlogBase title={humanize(tag || '')}>
  <BlogPageHeader title={humanize(tag || '')} />
  <div class="blog-container">
    <div class="blog-grid" style="grid-template-columns: repeat(3, 1fr);">
      {
        filterByTags.map((post) => (
          <BlogCard data={post} />
        ))
      }
    </div>
  </div>
</BlogBase>

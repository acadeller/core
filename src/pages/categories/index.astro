---
import config from "@/config/config.json";
import BlogBase from "@/layouts/BlogBase.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import BlogPageHeader from "@/partials/BlogPageHeader.astro";

const { blog_folder }: { blog_folder: string } = config.settings;
const categories = await getTaxonomy(blog_folder, "categories");
const allCategories = await getAllTaxonomy(blog_folder, "categories");
---

<BlogBase title="Categorías">
  <BlogPageHeader title="Categorías" />
  <div class="blog-container">
    <div class="tags-list" style="justify-content: center; gap: 12px;">
      {
        categories.map((category: string) => {
          const count = allCategories.filter((c) => c === category).length;
          return (
            <a
              href={`/categories/${category}`}
              class="tag-item"
              style="padding: 12px 20px; font-size: 16px;"
            >
              {humanize(category)}
              <span style="margin-left: 8px; opacity: 0.6;">({count})</span>
            </a>
          );
        })
      }
    </div>
  </div>
</BlogBase>

---
// LandingNav.astro - Sticky navigation for landing page
import LampLogo from "@/components/LampLogo.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import LandingThemeSwitcher from "@/components/LandingThemeSwitcher.astro";
import { content, type Lang } from "@/config/landing";

// Default to English, client-side will update based on localStorage
const defaultLang: Lang = 'en';
const t = content[defaultLang];
---

<nav class="landing-nav">
  <div class="landing-nav-inner">
    <LampLogo />

    <!-- Mobile menu toggle -->
    <input id="landing-nav-toggle" type="checkbox" class="landing-nav-checkbox" />
    <label for="landing-nav-toggle" class="landing-nav-toggler">
      <svg class="landing-hamburger-icon" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg class="landing-close-icon" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>

    <div class="landing-nav-right">
      <LanguageSwitcher />
      <LandingThemeSwitcher />
      <a class="landing-btn landing-btn-primary" href="#contact" data-i18n="cta">
        <span class="btn-text">{t.cta}</span>
        <svg class="landing-btn-arrow" viewBox="0 0 14 14" fill="none">
          <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</nav>

<script>
  import { content, type Lang } from "@/config/landing";

  function updateNavText() {
    const lang = (window.getCurrentLang?.() || 'en') as Lang;
    const t = content[lang];

    // Update CTA button text
    const ctaBtn = document.querySelector('[data-i18n="cta"] .btn-text');
    if (ctaBtn) {
      ctaBtn.textContent = t.cta;
    }
  }

  function initMobileMenu() {
    const navToggle = document.getElementById('landing-nav-toggle') as HTMLInputElement;
    const navRight = document.querySelector('.landing-nav-right');

    if (!navToggle || !navRight) return;

    // Close menu when clicking on CTA button
    const ctaBtn = navRight.querySelector('.landing-btn');
    if (ctaBtn) {
      ctaBtn.addEventListener('click', () => {
        navToggle.checked = false;
      });
    }

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const isNavClick = target.closest('.landing-nav-inner');

      if (!isNavClick && navToggle.checked) {
        navToggle.checked = false;
      }
    });
  }

  // Update on language change
  window.addEventListener('langchange', updateNavText);

  // Initial update
  document.addEventListener('DOMContentLoaded', () => {
    updateNavText();
    initMobileMenu();
  });

  document.addEventListener('astro:page-load', () => {
    updateNavText();
    initMobileMenu();
  });
</script>

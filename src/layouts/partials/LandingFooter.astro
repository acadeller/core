---
// LandingFooter.astro - 4-column footer for landing page
import LampLogo from "@/components/LampLogo.astro";
import { content, SOCIALS, type Lang } from "@/config/landing";

const defaultLang: Lang = 'en';
const t = content[defaultLang];
const currentYear = new Date().getFullYear();
---

<footer class="landing-footer">
  <div class="landing-footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <LampLogo />
        <p class="tag" data-i18n="footTag">{t.footTag}</p>
      </div>
      <div class="footer-col" id="footer-links">
        <h4 data-i18n="footLinks">{t.footLinks}</h4>
        <ul>
          {t.footLinksList.map(([title, url]) => (
            <li><a href={url}>{title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col" id="footer-services">
        <h4 data-i18n="footServ">{t.footServ}</h4>
        <ul>
          {t.services.map(([title]) => (
            <li><a href="#services">{title}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4 data-i18n="footSocial">{t.footSocial}</h4>
        <ul>
          {SOCIALS.map(([name, url]) => (
            <li><a href={url} target="_blank" rel="noopener">{name} <span class="arrow">→</span></a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span data-i18n="footMeta">{t.footMeta.replace('2026', String(currentYear))}</span>
      <a href={`mailto:${t.ctaMail}`}>{t.ctaMail}</a>
    </div>
  </div>
</footer>

<script>
  import { content, type Lang } from "@/config/landing";

  function updateFooterText() {
    const lang = (window.getCurrentLang?.() || 'en') as Lang;
    const t = content[lang];
    const currentYear = new Date().getFullYear();

    // Update text elements
    const footTag = document.querySelector('[data-i18n="footTag"]');
    if (footTag) footTag.textContent = t.footTag;

    const footLinks = document.querySelector('[data-i18n="footLinks"]');
    if (footLinks) footLinks.textContent = t.footLinks;

    // Update links list
    const linksCol = document.getElementById('footer-links');
    if (linksCol) {
      const ul = linksCol.querySelector('ul');
      if (ul) {
        ul.innerHTML = t.footLinksList.map(([title, url]) =>
          `<li><a href="${url}">${title}</a></li>`
        ).join('');
      }
    }

    const footServ = document.querySelector('[data-i18n="footServ"]');
    if (footServ) footServ.textContent = t.footServ;

    const footSocial = document.querySelector('[data-i18n="footSocial"]');
    if (footSocial) footSocial.textContent = t.footSocial;

    const footMeta = document.querySelector('[data-i18n="footMeta"]');
    if (footMeta) footMeta.textContent = t.footMeta.replace('2026', String(currentYear));

    // Update services list
    const servicesCol = document.getElementById('footer-services');
    if (servicesCol) {
      const ul = servicesCol.querySelector('ul');
      if (ul) {
        ul.innerHTML = t.services.map(([title]) =>
          `<li><a href="#services">${title}</a></li>`
        ).join('');
      }
    }
  }

  // Update on language change
  window.addEventListener('langchange', updateFooterText);

  // Initial update
  document.addEventListener('DOMContentLoaded', updateFooterText);
  document.addEventListener('astro:page-load', updateFooterText);
</script>

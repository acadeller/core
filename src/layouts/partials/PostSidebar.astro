---
// PostSidebar.astro - Blog sidebar with i18n support
import { humanize } from "@/lib/utils/textConverter";
import { content, type Lang } from "@/config/landing";

const { tags, categories, allCategories } = Astro.props;
const t = content.en; // Default to English for SSR
---

<aside class="blog-sidebar">
  <!-- Categories -->
  <div class="sidebar-section">
    <h4 data-i18n="sidebarCategories">{t.blog.categories}</h4>
    <div class="sidebar-box">
      <ul>
        {
          categories.map((category: any) => {
            const count = allCategories.filter(
              (c: any) => c === category
            ).length;
            return (
              <li>
                <a href={`/categories/${category}`}>
                  {humanize(category)}
                  <span>({count})</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <!-- Tags -->
  <div class="sidebar-section">
    <h4 data-i18n="sidebarTags">{t.blog.tags}</h4>
    <div class="sidebar-box">
      <div class="tags-list">
        {
          tags.map((tag: any) => (
            <a class="tag-item" href={`/tags/${tag}`}>
              {humanize(tag)}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</aside>

<script>
  import { content, type Lang } from '@/config/landing';

  function updateSidebarText() {
    const lang = ((window as any).getCurrentLang?.() || 'en') as Lang;
    const t = content[lang];

    const categoriesH4 = document.querySelector('[data-i18n="sidebarCategories"]');
    if (categoriesH4) categoriesH4.textContent = t.blog.categories;

    const tagsH4 = document.querySelector('[data-i18n="sidebarTags"]');
    if (tagsH4) tagsH4.textContent = t.blog.tags;
  }

  window.addEventListener('langchange', updateSidebarText);
  document.addEventListener('DOMContentLoaded', updateSidebarText);
  document.addEventListener('astro:page-load', updateSidebarText);
</script>

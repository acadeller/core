---
// AuthorCard.astro - Author card component with landing design system
import { plainify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { data } = Astro.props;
const { title, image, social } = data.data;
---

<a href={`/autores/${data.slug}`} class="author-card-link">
  <article class="author-card">
    {
      image && (
        <div class="author-card-image">
          <Image
            src={image}
            alt={title}
            width={120}
            height={120}
            format="webp"
          />
        </div>
      )
    }
    <div class="author-card-content">
      <h4>{title}</h4>
      <p>{plainify(data.body?.slice(0, 100))}</p>
      {
        social && social.length > 0 && (
          <div class="author-card-socials">
            {social.slice(0, 3).map((s: { name: string }) => (
              <span class="social-tag">{s.name}</span>
            ))}
          </div>
        )
      }
    </div>
    <div class="author-card-arrow">
      <svg viewBox="0 0 14 14" fill="none" width="14" height="14">
        <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </article>
</a>

<style>
  .author-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .author-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .author-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .author-card-image {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border: 1.5px solid var(--ink);
    box-shadow: 3px 3px 0 var(--acc);
    overflow: hidden;
  }

  [data-theme="bw"] .author-card-image {
    box-shadow: 3px 3px 0 var(--ink);
  }

  .author-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-card-content {
    flex: 1;
    min-width: 0;
  }

  .author-card-content h4 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    color: var(--ink);
  }

  .author-card-content p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .author-card-socials {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .social-tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    background: color-mix(in srgb, var(--ink) 6%, var(--paper));
    border: 1px solid var(--line);
    color: var(--ink-3);
  }

  .author-card-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    transition: background 0.15s, color 0.15s, transform 0.15s;
  }

  .author-card:hover .author-card-arrow {
    background: var(--acc);
    color: var(--acc-ink);
    transform: translateX(4px);
  }

  [data-theme="bw"] .author-card:hover .author-card-arrow {
    background: var(--ink);
    color: var(--paper);
  }
</style>

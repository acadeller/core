---
import BlogCard from "@/components/BlogCard.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";

const { blog_folder } = config.settings;
const posts = await getSinglePage(blog_folder);
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.slug);
const { Content } = await post.render();
const { title, description, author, categories, image, date, tags } = post.data;
---

<article class="blog-single">
  <header class="blog-single-header">
    <div class="blog-single-meta">
      <a href={`/autores/${slugify(author)}`}>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="10" cy="7" r="4"/>
          <path d="M3 18c0-3.3 3.1-6 7-6s7 2.7 7 6"/>
        </svg>
        {humanize(author)}
      </a>
      <span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="14" height="14" rx="2"/>
          <path d="M3 8h14M7 2v4M13 2v4"/>
        </svg>
        {dateFormat(date)}
      </span>
      {
        categories.map((category: string, index: number) => (
          <a href={`/categories/${slugify(category)}`}>
            {humanize(category)}
          </a>
        ))
      }
    </div>
    <h1 set:html={markdownify(title)} />
  </header>

  {
    image && (
      <div class="blog-single-image">
        <Image
          src={image}
          height={500}
          width={1200}
          alt={title}
          format="webp"
        />
      </div>
    )
  }

  <div class="blog-content">
    <Content />
  </div>

  <footer class="blog-single-footer">
    <div class="blog-tags">
      <h5>Tags:</h5>
      {
        tags.map((tag: string) => (
          <a class="tag-item" href={`/tags/${slugify(tag)}`}>
            {humanize(tag)}
          </a>
        ))
      }
    </div>
    <div class="blog-share">
      <h5>Compartir:</h5>
      <Share
        className="social-icons"
        title={title}
        description={description}
        slug={post.slug}
      />
    </div>
  </footer>

  <!-- Related posts -->
  {
    similarPosts.length > 0 && (
      <section class="related-posts">
        <h2>Publicaciones relacionadas</h2>
        <div class="related-grid">
          {similarPosts.slice(0, 3).map((post) => (
            <BlogCard data={post} />
          ))}
        </div>
      </section>
    )
  }
</article>
